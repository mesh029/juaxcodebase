# ── Jua X — client env (never commit real secrets) ──────────────────
# App runs in offline-demo mode when API/Mapbox are unset.

# Backend API (Aiden). No trailing slash.
# Local LAN example: http://192.168.1.42:5080
# Production example: https://juax-backend.vercel.app
EXPO_PUBLIC_API_BASE_URL=

# WebSocket URL if different from API (optional).
# Falls back to ws(s):// derived from API base + /socket
EXPO_PUBLIC_WS_URL=

# Mapbox public token (pk.*) — maps, geocoding, directions
EXPO_PUBLIC_MAPBOX_TOKEN=

# Optional crash reporting — no-op when empty
EXPO_PUBLIC_SENTRY_DSN=

# Dropbox — prefer server-side upload via POST /api/v1/media/upload.
# Client token is a fallback only (not recommended for production).
EXPO_PUBLIC_DROPBOX_APP_KEY=
EXPO_PUBLIC_DROPBOX_ACCESS_TOKEN=

# Optional legal links (deep-link / WebBrowser; no new screens required)
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
EXPO_PUBLIC_TERMS_URL=https://example.com/terms

# ── Server-only (do NOT put these in the Expo app) ──────────────────
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=
# DROPBOX_REFRESH_TOKEN=
# DROPBOX_APP_SECRET=
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_USERNAME=
