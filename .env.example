# Backend API (required for live auth, listings, FUA)
# Local dev — use your machine's LAN IP so the phone/emulator can reach it:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:5080
# Vercel production — no trailing slash:
EXPO_PUBLIC_API_BASE_URL=https://juax-backend.vercel.app

# Mapbox — maps, geocoding, directions
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here
