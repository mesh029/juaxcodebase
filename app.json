{
  "expo": {
    "name": "Jua X",
    "slug": "jua-x",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0700"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.juax.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Jua X uses your location to find nearby stays, laundry stations, and calculate ride routes.",
        "NSCameraUsageDescription": "Jua X uses the camera for laundry proof and listing photos.",
        "NSPhotoLibraryUsageDescription": "Jua X accesses photos for profile and listing images."
      }
    },
    "android": {
      "package": "com.juax.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0700"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "navigationBar": {
        "backgroundColor": "#FFFBF0",
        "barStyle": "dark-content"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Jua X uses your location to find nearby stays, laundry stations, and calculate ride routes."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#C9A227"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Jua X accesses photos for profile and listing images.",
          "cameraPermission": "Jua X uses the camera for laundry proof and listing photos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "owner": "juax"
  }
}
